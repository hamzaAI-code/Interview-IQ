# Gemini
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro

# Neo4j (local docker-compose defaults)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=interview_agent_pw
NEO4J_DATABASE=neo4j

# Interview tuning
COVERAGE_THRESHOLD=0.70
MAX_FOLLOWUPS=3
MAX_TOPICS=8
# Free clarifications/meta/off-topic responses per topic before they start counting as attempts
MAX_CLARIFICATIONS=2

# Logging
LOG_LEVEL=INFO
